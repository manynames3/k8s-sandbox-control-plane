# Generated by deploy/kind/up.sh from this template. @WORKERS@ extra worker nodes are appended.
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
networking:
  disableDefaultCNI: true        # Calico is installed so NetworkPolicy is really enforced
  podSubnet: 10.244.0.0/16
  serviceSubnet: 10.96.0.0/12
kubeadmConfigPatches:
  - |
    kind: KubeletConfiguration
    podPidsLimit: 256            # fork-bomb containment (attack suite)
    maxPods: 60
nodes:
  - role: control-plane
    image: @IMAGE@
@WORKER_NODES@
